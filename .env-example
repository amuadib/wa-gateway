APP_NAME="Whatsapp Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://wa-gateway.local

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wa_gateway
DB_USERNAME=wa_gateway
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

BAILEYS_V7_API_URL="http://127.0.0.1:3000"
BAILEYS_V7_HOST=127.0.0.1
BAILEYS_V7_PORT=3000
BAILEYS_V7_WEBHOOK_URL="http://wa-gateway.local/webhook/baileys-v7"
BAILEYS_V7_WEBHOOK_INSECURE=true
BAILEYS_V7_SESSIONS_DIR="../storage/app/baileys-sessions"
BAILEYS_V7_API_KEY="GANTI_DENGAN_TOKEN_RAHASIA"
DEBUG_BAILEYS_WEBHOOK=false

KEEP_WA_MESSAGES_DAYS=7
SEND_ONLY_FROM_DEVICE_GROUP=true

TELEGRAM_API_TOKEN=""
TELEGRAM_CHANNEL=""

PM2_APP_NAME=wa-baileys
PM2_NODE_BIN="/path/to/node.exe"
PM2_BIN="/path/to/pm2/bin/pm2"
PM2_HOME="/path/to/.pm2"
